# Copy to .env (which is gitignored) before running `docker compose up`.
BORROWER_ID=your-library-card-number
BORROWER_PASSWORD=your-4-digit-pin
# Comma separated. Failure alerts only go to the first address.
EMAIL_TO=you@example.com,someone-else@example.com
MAILGUN_API_KEY=your-mailgun-sending-key
MAILGUN_DOMAIN=mg.example.com
# Uncomment for a domain in Mailgun's EU region.
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
# Optional; defaults to "Library Monitor <library-monitor@MAILGUN_DOMAIN>".
# EMAIL_FROM=Library Monitor <library@mg.example.com>
